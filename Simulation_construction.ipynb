   "source": [
    "possession_cols = [\"game_id\", \"possession_number\"]\n",
    "\n",
    "visited_posssessions = cleaned_binned.groupby(possession_cols, observed=False)[\"sector\"].value_counts().reset_index()\n",
    "visited_posssessions[\"time\"] = visited_posssessions[\"count\"] * .04\n",
    "visited_posssessions[\"time_proportion\"] = (\n",
    "    visited_posssessions[\"count\"]\n",
    "    / visited_posssessions.groupby(possession_cols, observed=False)[\"count\"].transform(\"sum\")\n",
    ")\n",
    "\n",
    "possession_scoring = (\n",
    "    cleaned_binned.groupby(possession_cols, observed=False)[\"scored\"].max().reset_index()\n",
    ")\n",
    "\n",
    "visited_posssessions = visited_posssessions.merge(\n",
    "    possession_scoring,\n",
    "    on=possession_cols,\n",
    "    how=\"left\",\n",
    ")\n",
    "\n",
    "end_sector = (\n",
    "    cleaned_binned.drop_duplicates(possession_cols, keep=\"last\")\n",
    "    .assign(is_end_sector=True)[possession_cols + [\"sector\", \"is_end_sector\"]]\n",
    ")\n",
    "\n",
    "visited_posssessions = visited_posssessions.merge(\n",
    "    end_sector,\n",
    "    on=possession_cols + [\"sector\"],\n",
    "    how=\"left\",\n",
    ")\n",
    "visited_posssessions[\"is_end_sector\"] = visited_posssessions[\"is_end_sector\"].fillna(False)\n",
    "\n",
    "last_5_visited = (\n",
    "    cleaned_binned.drop_duplicates(possession_cols + [\"sector\"], keep=\"last\")\n",
    "    .groupby(possession_cols, observed=False)\n",
    "    .tail(5)\n",
    "    .assign(was_last_5_visited=True)[possession_cols + [\"sector\", \"was_last_5_visited\"]]\n",
    ")\n",
    "\n",
    "visited_posssessions = visited_posssessions.merge(\n",
    "    last_5_visited,\n",
    "    on=possession_cols + [\"sector\"],\n",
    "    how=\"left\",\n",
    ")\n",
    "visited_posssessions[\"was_last_5_visited\"] = visited_posssessions[\"was_last_5_visited\"].fillna(False)\n",
    "visited_posssessions\n"
   ]
  },
